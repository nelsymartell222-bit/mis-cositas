<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<wbs_view pagelayout="WBS Chart Page Layout" defaultarrange="orgchart" borderpolicy="outlinelevel" borderfillpolicy="outlinelevel" bordershadowpolicy="outlinelevel" hyperlinksymbols="yes" indicatenotes="yes" indicateconstraint="yes" indicatecompleted="yes" field="Duration">
	<connector crstyle="curve">
		<line id="in" width="1.5pt" color="dimgray"/>
		<line id="out" width="1.5pt" color="dimgray"/>
		<line id="common" width="1.5pt" color="dimgray"/>
	</connector>
	<item id="summary" drop="36pt" before="18pt"/>
	<item id="task" before="18pt"/>
	<border id="Critical Task" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Critical Milestone" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Critical Summary" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
