	<border id="Level 20 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow">
		<border_edge id="top" width="1.5pt"/>
		<border_edge id="left" width="1.5pt"/>
		<border_edge id="bottom" width="1.5pt"/>
		<border_edge id="right" width="1.5pt"/>
	</border>
	<border id="Level 20 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<grid id="summary" rows="1" cols="1">
		<row>
			<cell field="Name" format="1" type="wraptext" font-size="11pt" bold="yes" left_p="7.2pt" right_p="7.2pt" top_p="7.2pt" bottom_p="7.2pt" charlen="25"/>
		</row>
	</grid>
	<grid id="task" rows="1" cols="1">
		<row>
			<cell field="Name" type="wraptext" halign="left" font-size="11pt" bold="yes" color="default" left_p="1.45pt" right_p="1.45pt" top_p="1.45pt" bottom_p="1.45pt" charlen="25"/>
		</row>
	</grid>
	<groupspec>
	</groupspec>
</wbs_view>
