	<views current="WBS Chart View" current_wbs="WBS Chart View" current_nd="Network Chart View Basic" current_ts="Tracking Task Sheet View" current_gantt="Gantt Chart View" current_swimlane="Basic Swim Lane View">
		<ts_view id="Basic Swim Lane View" pagelayout="Gantt Chart Page Layout" ganttchart="yes" swimlanechart="yes" packbars="yes" hidesummarybars="yes" packmilestones="yes" lockfirst="no" fonttextpolicy="outlinelevel" fontfillpolicy="outlinelevel">
			<columns>
			</columns>
			<gantt>
				<options progresstasks="no" progresssummaries="no" progressmilestones="no" roundbars="no"/>
				<grid id="summary" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell halign="left" rowspan="3"/>
					</row>
					<row>
						<cell colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<grid id="task" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell halign="left" rowspan="3"/>
					</row>
					<row>
						<cell field="Name" font-size="10pt" bold="yes" colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<grid id="milestone" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" right_p="7.2pt" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell field="Finish" format="22" halign="left" font-size="9pt" bold="yes" left_p="7.2pt" rowspan="3"/>
					</row>
					<row>
						<cell colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<timescale tier="0"/>
				<timescale tier="1"/>
				<line id="start"/>
				<line id="finish"/>
				<line id="status"/>
				<line id="current"/>
				<line id="row" style="solid" color="darkgray" beforeSummary="1"/>
				<line id="timescale"/>
				<line id="uppertimescale"/>
				<dependencies>
					<line id="critical">
						<arrow id="to" bkcolor="maroon"/>
					</line>
					<line id="noncritical">
						<arrow id="to" bkcolor="#153F73"/>
					</line>
				</dependencies>
				<bar id="Critical Task" width="full" style="framedgradient" color="pink"/>
				<bar id="Critical Milestone" width="full" style="framedsolid" color="red">
					<marker id="start" shape="diamond"/>
				</bar>
				<bar id="Critical Summary" style="solid" color="gray">
					<marker id="start" shape="bracket_down" color="gray"/>
					<marker id="end" shape="bracket_down" color="gray"/>
				</bar>
				<bar id="Noncritical Task" width="full" style="framedgradient" color="skyblue"/>
				<bar id="Noncritical Milestone" width="full" style="framedsolid" color="blue">
					<marker id="start" shape="diamond"/>
