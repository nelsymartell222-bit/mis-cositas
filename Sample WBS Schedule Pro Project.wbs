		<wbs_view id="WBS Chart View" pagelayout="WBS Chart Page Layout" defaultarrange="wbs" borderpolicy="criticalpath" borderfillpolicy="criticalpath" bordershadowpolicy="criticalpath">
			<connector crstyle="curve">
				<line id="in" width="1.5pt" color="#46AAC5"/>
				<line id="out" width="1.5pt" color="#46AAC5"/>
				<line id="common" width="1.5pt" color="#46AAC5"/>
			</connector>
