<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<nd_view pagelayout="Network Chart Page Layout" borderpolicy="criticalpath" borderfillpolicy="criticalpath" bordershadowpolicy="criticalpath" hyperlinksymbols="yes" indicatenotes="yes" indicateconstraint="yes" indicatecompleted="yes" field="Duration" hspacing="5.05pt">
	<border id="Critical Task" shdir="bottom_right" shdepth="2.25pt" shcolor="red" color="red" bkcolor="lightyellow" bkstyle="gradient_top_bottom">
		<border_edge id="top" color="red"/>
		<border_edge id="left" color="red"/>
		<border_edge id="bottom" color="red"/>
		<border_edge id="right" color="red"/>
	</border>
	<border id="Critical Milestone" shape="curved_rect" shdir="bottom_right" shdepth="2.25pt" shcolor="red" color="red" bkcolor="lightyellow" bkstyle="gradient_top_bottom">
		<border_edge id="top" color="red"/>
		<border_edge id="left" color="red"/>
		<border_edge id="bottom" color="red"/>
		<border_edge id="right" color="red"/>
	</border>
	<border id="Critical Summary" shdir="bottom_right" shdepth="2.25pt" shcolor="red" color="red" bkcolor="lightyellow" bkstyle="gradient_top_bottom">
		<border_edge id="top" color="red"/>
		<border_edge id="left" color="red"/>
		<border_edge id="bottom" color="red"/>
		<border_edge id="right" color="red"/>
	</border>
	<border id="Noncritical Task" shdir="bottom_right" shdepth="2.25pt" shcolor="blue" color="blue" bkcolor="lightyellow" bkstyle="gradient_top_bottom">
		<border_edge id="top" color="blue"/>
		<border_edge id="left" color="blue"/>
		<border_edge id="bottom" color="blue"/>
		<border_edge id="right" color="blue"/>
	</border>
	<border id="Noncritical Milestone" shape="curved_rect" shdir="bottom_right" shdepth="2.25pt" shcolor="blue" color="blue" bkcolor="lightyellow" bkstyle="gradient_top_bottom">
		<border_edge id="top" color="blue"/>
		<border_edge id="left" color="blue"/>
		<border_edge id="bottom" color="blue"/>
		<border_edge id="right" color="blue"/>
	</border>
	<border id="Noncritical Summary" shdir="bottom_right" shdepth="2.25pt" shcolor="blue" color="blue" bkcolor="lightyellow" bkstyle="gradient_top_bottom">
		<border_edge id="top" color="blue"/>
		<border_edge id="left" color="blue"/>
		<border_edge id="bottom" color="blue"/>
		<border_edge id="right" color="blue"/>
	</border>
	<border id="External Task" shdir="bottom_right" shdepth="2.25pt" shcolor="dimgray" bkcolor="lightyellow" bkstyle="gradient_top_bottom"/>
	<grid id="task" rows="3" cols="2">
		<row>
			<cell field="Name" type="wraptext" font-size="10pt" bold="yes" left_p="4.3pt" right_p="4.3pt" top_p="0.7pt" bottom_p="0.7pt" left_s="solid" right_s="solid" bottom_s="solid" left_c="dimgray" right_c="dimgray" top_c="dimgray" bottom_c="dimgray" colspan="2" charlen="25"/>
		</row>
		<row>
			<cell field="ID" font-size="10pt" left_p="4.3pt" right_p="4.3pt" top_p="0.7pt" bottom_p="0.7pt" right_s="solid" top_s="solid" bottom_s="solid" left_c="dimgray" right_c="dimgray" top_c="dimgray" bottom_c="dimgray"/>
			<cell field="Duration" format="3" font-size="10pt" left_p="4.3pt" right_p="4.3pt" top_p="0.7pt" bottom_p="0.7pt" left_s="solid" top_s="solid" bottom_s="solid" left_c="dimgray" right_c="dimgray" top_c="dimgray" bottom_c="dimgray"/>
		</row>
		<row>
			<cell field="Start" format="1" font-size="10pt" left_p="4.3pt" right_p="4.3pt" top_p="0.7pt" bottom_p="0.7pt" right_s="solid" top_s="solid" left_c="dimgray" right_c="dimgray" top_c="dimgray" bottom_c="dimgray"/>
			<cell field="Finish" format="1" font-size="10pt" left_p="4.3pt" right_p="4.3pt" top_p="0.7pt" bottom_p="0.7pt" left_s="solid" top_s="solid" left_c="dimgray" right_c="dimgray" top_c="dimgray" bottom_c="dimgray"/>
		</row>
	</grid>
	<dependencies crstyle="curve" chstyle="medium" hidden-field="Name">
		<line id="critical" width="1pt">
			<arrow id="to" size="9pt"/>
		</line>
		<line id="noncritical" width="1pt">
			<arrow id="to" size="9pt"/>
		</line>
	</dependencies>
	<group nameformat="1">
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
		<cell halign="left" font-size="10pt" bold="yes" bkcolor="#D2F5FF" left_p="3.6pt" right_p="3.6pt" top_p="1.45pt" bottom_p="1.45pt" top_s="solid" bottom_s="solid" top_c="#46AAC5" bottom_c="#46AAC5"/>
	</group>
	<timescale range="yes">
		<cell font-size="10pt" bold="yes" bkcolor="#DAFDA8" left_p="2.9pt" right_p="2.9pt" top_p="1.45pt" bottom_p="1.45pt"/>
		<line style="solid" width="0pt" color="black"/>
	</timescale>
	<groupspec showempty="yes">
	</groupspec>
</nd_view>
