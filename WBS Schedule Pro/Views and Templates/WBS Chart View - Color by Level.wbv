	<border id="Level 8 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="#BE4B48" bkcolor="mistyrose" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#BE4B48"/>
		<border_edge id="left" width="1.5pt" color="#BE4B48"/>
		<border_edge id="bottom" width="1.5pt" color="#BE4B48"/>
		<border_edge id="right" width="1.5pt" color="#BE4B48"/>
	</border>
	<border id="Level 8 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 9 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="darkgreen" bkcolor="lime" bkstyle="gradient_top_bottom">
