<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<wbs_view pagelayout="WBS Chart Page Layout" defaultarrange="orgchart" borderpolicy="criticalpath" borderfillpolicy="criticalpath" bordershadowpolicy="criticalpath" hyperlinksymbols="yes" indicatenotes="yes" indicateconstraint="yes" indicatecompleted="yes">
	<connector crstyle="curve">
		<line id="in" width="1.5pt" color="#46AAC5"/>
		<line id="out" width="1.5pt" color="#46AAC5"/>
		<line id="common" width="1.5pt" color="#46AAC5"/>
	</connector>
	<item id="summary" drop="36pt" before="18pt"/>
	<item id="task" before="18pt"/>
	<border id="Critical Task" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" color="#46AAC5" bkcolor="#B5EEFF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#46AAC5"/>
		<border_edge id="left" width="1.5pt" color="#46AAC5"/>
		<border_edge id="bottom" width="1.5pt" color="#46AAC5"/>
		<border_edge id="right" width="1.5pt" color="#46AAC5"/>
	</border>
	<border id="Critical Milestone" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" color="#46AAC5" bkcolor="#B5EEFF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#46AAC5"/>
		<border_edge id="left" width="1.5pt" color="#46AAC5"/>
		<border_edge id="bottom" width="1.5pt" color="#46AAC5"/>
		<border_edge id="right" width="1.5pt" color="#46AAC5"/>
	</border>
	<border id="Critical Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" color="#46AAC5" bkcolor="#B5EEFF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#46AAC5"/>
		<border_edge id="left" width="1.5pt" color="#46AAC5"/>
		<border_edge id="bottom" width="1.5pt" color="#46AAC5"/>
		<border_edge id="right" width="1.5pt" color="#46AAC5"/>
	</border>
	<border id="Noncritical Task" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" color="#46AAC5" bkcolor="#B5EEFF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#46AAC5"/>
		<border_edge id="left" width="1.5pt" color="#46AAC5"/>
		<border_edge id="bottom" width="1.5pt" color="#46AAC5"/>
		<border_edge id="right" width="1.5pt" color="#46AAC5"/>
	</border>
	<border id="Noncritical Milestone" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" color="#46AAC5" bkcolor="#B5EEFF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#46AAC5"/>
		<border_edge id="left" width="1.5pt" color="#46AAC5"/>
		<border_edge id="bottom" width="1.5pt" color="#46AAC5"/>
		<border_edge id="right" width="1.5pt" color="#46AAC5"/>
	</border>
	<border id="Noncritical Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" color="#46AAC5" bkcolor="#B5EEFF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#46AAC5"/>
		<border_edge id="left" width="1.5pt" color="#46AAC5"/>
		<border_edge id="bottom" width="1.5pt" color="#46AAC5"/>
		<border_edge id="right" width="1.5pt" color="#46AAC5"/>
	</border>
	<border id="External Task" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" color="#46AAC5" bkcolor="#B5EEFF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#46AAC5"/>
		<border_edge id="left" width="1.5pt" color="#46AAC5"/>
		<border_edge id="bottom" width="1.5pt" color="#46AAC5"/>
		<border_edge id="right" width="1.5pt" color="#46AAC5"/>
	</border>
	<border id="Level 0 (Project Summary)" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 1 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 1 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 2 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 2 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 3 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 3 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 4 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 4 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 5 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 5 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 6 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 6 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 7 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 7 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 8 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 8 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 9 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 9 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 10 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 10 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 11 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 11 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 12 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 12 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 13 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 13 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 14 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 14 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 15 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 15 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 16 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 16 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 17 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 17 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 18 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 18 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 19 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 19 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 20 Summary" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<border id="Level 20 Task" shape="curved_rect" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow"/>
	<grid id="summary" rows="1" cols="1">
		<row>
			<cell field="Name" format="1" type="wraptext" font-size="11pt" bold="yes" left_p="7.2pt" right_p="7.2pt" top_p="7.2pt" bottom_p="7.2pt" left_c="default" right_c="default" top_c="default" bottom_c="default" charlen="25"/>
		</row>
	</grid>
	<grid id="task" rows="1" cols="1">
		<row>
			<cell field="Name" format="1" type="wraptext" font-size="11pt" bold="yes" left_p="7.2pt" right_p="7.2pt" top_p="7.2pt" bottom_p="7.2pt" left_c="default" right_c="default" top_c="default" bottom_c="default" charlen="25"/>
		</row>
	</grid>
	<groupspec>
	</groupspec>
</wbs_view>
