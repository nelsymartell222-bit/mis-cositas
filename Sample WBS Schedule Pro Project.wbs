		<ts_view id="Swim Lane Network Chart" pagelayout="Gantt Chart Page Layout" ganttchart="yes" swimlanechart="yes" packbars="yes" hidesummarybars="yes" packmilestones="yes" horiztext="yes" lockfirst="no" fonttextpolicy="criticalpath" fontfillpolicy="criticalpath">
			<columns>
			</columns>
			<gantt>
				<options progresstasks="no" progresssummaries="no" progressmilestones="no" shownonworking="no" roundbars="no"/>
				<grid id="summary" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell halign="left" rowspan="3"/>
					</row>
					<row>
						<cell colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<grid id="task" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell halign="left" rowspan="3"/>
					</row>
					<row>
						<cell field="Name" font-size="10pt" bold="yes" left_p="0.7pt" right_p="0.7pt" top_p="1.45pt" bottom_p="1.45pt" colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<grid id="milestone" rows="3" cols="5" top="1" left="1" bottom="1" right="3" cliptext="no">
					<row stretch="yes">
						<cell halign="right" right_p="7.2pt" rowspan="3"/>
						<cell halign="left"/>
						<cell stretch="yes"/>
						<cell halign="right"/>
						<cell field="Finish" format="22" halign="left" font-size="9pt" bold="yes" left_p="7.2pt" rowspan="3"/>
					</row>
					<row>
						<cell colspan="3"/>
					</row>
					<row stretch="yes">
						<cell halign="left"/>
						<cell/>
						<cell halign="right"/>
					</row>
				</grid>
				<timescale tier="0"/>
				<timescale tier="1"/>
				<line id="start" style="null" color="black"/>
				<line id="finish" style="null" color="black"/>
				<line id="status" style="null" color="black"/>
				<line id="current" style="null" color="black"/>
				<line id="row" color="black" beforeSummary="1"/>
				<line id="timescale" color="black"/>
				<line id="uppertimescale" style="solid" color="darkgray"/>
				<dependencies>
					<line id="critical">
						<arrow id="to" bkcolor="maroon"/>
					</line>
					<line id="noncritical">
						<arrow id="to" bkcolor="#153F73"/>
					</line>
				</dependencies>
				<bar id="Critical Task" width="full" style="framedgradient" color="#FF8A9E"/>
				<bar id="Critical Milestone" width="full" style="framedsolid" color="red">
					<marker id="start" shape="diamond"/>
				</bar>
				<bar id="Critical Summary" style="solid" color="gray">
					<marker id="start" shape="bracket_down" color="gray"/>
					<marker id="end" shape="bracket_down" color="gray"/>
				</bar>
				<bar id="Noncritical Task" width="full" style="framedgradient" color="#6FBAD2"/>
				<bar id="Noncritical Milestone" width="full" style="framedsolid" color="blue">
					<marker id="start" shape="diamond"/>
				</bar>
				<bar id="Noncritical Summary" style="solid" color="gray">
					<marker id="start" shape="bracket_down" color="gray"/>
					<marker id="end" shape="bracket_down" color="gray"/>
				</bar>
				<bar id="External Task" width="full" style="framedsolid" color="gray"/>
			</gantt>
