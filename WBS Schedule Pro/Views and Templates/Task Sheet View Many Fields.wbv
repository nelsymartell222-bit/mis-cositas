<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<ts_view pagelayout="Task Sheet Page Layout" fonttextpolicy="criticalpath" fontfillpolicy="criticalpath">
	<columns>
		<column field="ID" aligndata="center" width="30"/>
		<column field="% Complete" title="% Comp" aligndata="left" width="46"/>
		<column field="Name" format="1" aligndata="left" width="262"/>
		<column field="Duration" aligndata="left" width="60"/>
		<column field="Actual Duration" aligndata="left" width="59"/>
		<column field="Remaining Duration" aligndata="left" width="73"/>
		<column field="Start" aligndata="left" width="70"/>
		<column field="Actual Start" aligndata="left" width="70"/>
		<column field="Finish" aligndata="left" width="70"/>
		<column field="Actual Finish" aligndata="left" width="70"/>
		<column field="Work" aligndata="left" width="53"/>
		<column field="Actual Work" aligndata="left" width="54"/>
		<column field="Remaining Work" aligndata="left" width="73"/>
		<column field="Cost" aligndata="left" width="75"/>
		<column field="Actual Cost" aligndata="left" width="75"/>
		<column field="Remaining Cost" aligndata="left" width="75"/>
	</columns>
	<sheetcell id="Critical Task" font-size="10pt"/>
	<sheetcell id="Critical Milestone" font-size="10pt"/>
	<sheetcell id="Critical Summary" font-size="10pt" bold="yes"/>
	<sheetcell id="Noncritical Task" font-size="10pt"/>
	<sheetcell id="Noncritical Milestone" font-size="10pt"/>
	<sheetcell id="Noncritical Summary" font-size="10pt" bold="yes"/>
	<sheetcell id="External Task" font-size="10pt"/>
	<sheetcell id="No Flag Task" font-size="10pt"/>
	<sheetcell id="No Flag Summary" font-size="10pt" bold="yes"/>
	<sheetcell id="Flag1" font-size="10pt"/>
	<sheetcell id="Flag2" font-size="10pt"/>
	<sheetcell id="Flag3" font-size="10pt"/>
	<sheetcell id="Flag4" font-size="10pt"/>
	<sheetcell id="Flag5" font-size="10pt"/>
	<sheetcell id="Flag6" font-size="10pt"/>
	<sheetcell id="Flag7" font-size="10pt"/>
	<sheetcell id="Flag8" font-size="10pt"/>
	<sheetcell id="Flag9" font-size="10pt"/>
	<sheetcell id="Flag10" font-size="10pt"/>
	<sheetcell id="Flag11" font-size="10pt"/>
	<sheetcell id="Flag12" font-size="10pt"/>
	<sheetcell id="Flag13" font-size="10pt"/>
	<sheetcell id="Flag14" font-size="10pt"/>
	<sheetcell id="Flag15" font-size="10pt"/>
	<sheetcell id="Flag16" font-size="10pt"/>
	<sheetcell id="Flag17" font-size="10pt"/>
	<sheetcell id="Flag18" font-size="10pt"/>
	<sheetcell id="Flag19" font-size="10pt"/>
	<sheetcell id="Flag20" font-size="10pt"/>
	<sheetcell id="Not Started Task" font-size="10pt"/>
	<sheetcell id="Not Started Milestone" font-size="10pt"/>
	<sheetcell id="Not Started Summary" font-size="10pt" bold="yes"/>
	<sheetcell id="In Progress Task" font-size="10pt"/>
	<sheetcell id="In Progress Summary" font-size="10pt" bold="yes"/>
	<sheetcell id="Completed Task" font-size="10pt"/>
	<sheetcell id="Completed Milestone" font-size="10pt"/>
	<sheetcell id="Completed Summary" font-size="10pt" bold="yes"/>
	<sheetcell id="Level 0 (Project Summary)" font-size="10pt" bold="yes"/>
	<sheetcell id="Level 1 Summary" font-size="10pt" bold="yes"/>
	<sheetcell id="Level 1 Task" font-size="10pt"/>
	<sheetcell id="Level 2 Summary" font-size="10pt" bold="yes"/>
	<sheetcell id="Level 2 Task" font-size="10pt"/>
