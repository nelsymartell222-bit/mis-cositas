		<border_edge id="bottom" width="1.5pt"/>
		<border_edge id="right" width="1.5pt"/>
	</border>
	<border id="Level 12 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 13 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow">
		<border_edge id="top" width="1.5pt"/>
		<border_edge id="left" width="1.5pt"/>
		<border_edge id="bottom" width="1.5pt"/>
		<border_edge id="right" width="1.5pt"/>
	</border>
	<border id="Level 13 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 14 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" bkcolor="lightyellow">
