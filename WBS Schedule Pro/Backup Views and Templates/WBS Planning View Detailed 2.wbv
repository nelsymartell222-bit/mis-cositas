	<grid id="summary" rows="4" cols="2">
		<row stretch="yes">
			<cell field="WBS" font-size="11pt" bold="yes" orient="bottomtop" color="red" bkcolor="#DADADA" left_p="3.6pt" right_p="3.6pt" top_p="7.2pt" bottom_p="7.2pt" right_s="solid" right_c="gray" rowspan="4" charlen="25" bkstyle="gradient_top_bottom"/>
			<cell field="Name" type="wraptext" font-size="11pt" bold="yes" bkcolor="silver" left_p="3.6pt" right_p="3.6pt" top_p="3.6pt" bottom_p="3.6pt" left_s="solid" left_c="gray" stretch="yes" charlen="20" bkstyle="gradient_top_bottom"/>
		</row>
		<row>
			<cell field="Duration" format="5" halign="left" font-size="11pt" bkcolor="#E1E1E1" label="Duration: " left_p="7.2pt" right_p="7.2pt" top_p="1.45pt" bottom_p="1.45pt" left_s="solid" left_c="gray" charlen="25" bkstyle="gradient_top_bottom"/>
		</row>
		<row>
			<cell field="Start" halign="left" font-size="11pt" bkcolor="#C9C9C9" label="Start:       " left_p="7.2pt" right_p="7.2pt" top_p="1.45pt" bottom_p="1.45pt" left_s="solid" left_c="gray" charlen="25"/>
		</row>
		<row>
			<cell field="Finish" halign="left" font-size="11pt" bkcolor="#E1E1E1" label="Finish:     " left_p="7.2pt" right_p="7.2pt" top_p="1.45pt" bottom_p="1.45pt" left_s="solid" left_c="gray" charlen="25" bkstyle="gradient_top_bottom"/>
		</row>
	</grid>
