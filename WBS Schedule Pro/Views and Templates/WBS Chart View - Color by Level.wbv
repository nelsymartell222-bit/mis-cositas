<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<wbs_view pagelayout="WBS Chart Page Layout" defaultarrange="wbs" borderpolicy="outlinelevel" borderfillpolicy="outlinelevel" bordershadowpolicy="criticalpath">
	<connector crstyle="curve">
		<line id="in" width="1.5pt" color="dimgray"/>
		<line id="out" width="1.5pt" color="dimgray"/>
		<line id="common" width="1.5pt" color="dimgray"/>
	</connector>
	<item id="summary" drop="21.6pt" before="21.6pt"/>
	<item id="task" before="3.6pt" listmode="stemleft"/>
	<border id="Critical Task" style="null" shcolor="darkgray" bkcolor="lightyellow"/>
	<border id="Critical Milestone" style="null" shcolor="darkgray" bkcolor="lightyellow"/>
	<border id="Critical Summary" shape="curved_rect" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" bkcolor="lightyellow"/>
	<border id="Noncritical Task" style="null" shcolor="darkgray" bkcolor="lightyellow"/>
	<border id="Noncritical Milestone" style="null" shcolor="darkgray" bkcolor="lightyellow"/>
	<border id="Noncritical Summary" shape="curved_rect" shdir="bottom_right" shdepth="2.25pt" shcolor="darkgray" bkcolor="lightyellow"/>
	<border id="External Task" style="null" shcolor="darkgray" bkcolor="lightyellow"/>
	<border id="Level 0 (Project Summary)" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="olive" bkcolor="khaki" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="olive"/>
		<border_edge id="left" width="1.5pt" color="olive"/>
		<border_edge id="bottom" width="1.5pt" color="olive"/>
		<border_edge id="right" width="1.5pt" color="olive"/>
	</border>
	<border id="Level 1 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="#46AAC5" bkcolor="#B5EEFF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#46AAC5"/>
		<border_edge id="left" width="1.5pt" color="#46AAC5"/>
		<border_edge id="bottom" width="1.5pt" color="#46AAC5"/>
		<border_edge id="right" width="1.5pt" color="#46AAC5"/>
	</border>
	<border id="Level 1 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 2 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="#7D60A0" bkcolor="#E4DAF8" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#7D60A0"/>
		<border_edge id="left" width="1.5pt" color="#7D60A0"/>
		<border_edge id="bottom" width="1.5pt" color="#7D60A0"/>
		<border_edge id="right" width="1.5pt" color="#7D60A0"/>
	</border>
	<border id="Level 2 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 3 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="#357E49" bkcolor="#DAFDA8" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#357E49"/>
		<border_edge id="left" width="1.5pt" color="#357E49"/>
		<border_edge id="bottom" width="1.5pt" color="#357E49"/>
		<border_edge id="right" width="1.5pt" color="#357E49"/>
	</border>
	<border id="Level 3 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 4 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="#BE4B48" bkcolor="#FFCCCB" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#BE4B48"/>
		<border_edge id="left" width="1.5pt" color="#BE4B48"/>
		<border_edge id="bottom" width="1.5pt" color="#BE4B48"/>
		<border_edge id="right" width="1.5pt" color="#BE4B48"/>
	</border>
	<border id="Level 4 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 5 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="#AE841A" bkcolor="#FEFF9C">
		<border_edge id="top" width="1.5pt" color="#AE841A"/>
		<border_edge id="left" width="1.5pt" color="#AE841A"/>
		<border_edge id="bottom" width="1.5pt" color="#AE841A"/>
		<border_edge id="right" width="1.5pt" color="#AE841A"/>
	</border>
	<border id="Level 5 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 6 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="#4A7EBB" bkcolor="#A4C5FF" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#4A7EBB"/>
		<border_edge id="left" width="1.5pt" color="#4A7EBB"/>
		<border_edge id="bottom" width="1.5pt" color="#4A7EBB"/>
		<border_edge id="right" width="1.5pt" color="#4A7EBB"/>
	</border>
	<border id="Level 6 Task" style="null" shdir="bottom_right" shdepth="4.5pt" bkcolor="none"/>
	<border id="Level 7 Summary" shape="curved_rect" width="1.5pt" shdir="bottom_right" shdepth="4.5pt" color="#7D60A0" bkcolor="plum" bkstyle="gradient_top_bottom">
		<border_edge id="top" width="1.5pt" color="#7D60A0"/>
		<border_edge id="left" width="1.5pt" color="#7D60A0"/>
		<border_edge id="bottom" width="1.5pt" color="#7D60A0"/>
		<border_edge id="right" width="1.5pt" color="#7D60A0"/>
	</border>
